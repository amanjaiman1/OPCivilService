{
  "name": "@doordie/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "validate": "expo install --check",
    "export:android": "expo export --platform android --output-dir dist/android",
    "export:ios": "expo export --platform ios --output-dir dist/ios",
    "lint": "node ../../node_modules/eslint/bin/eslint.js --no-ignore \"app/**/*.tsx\" \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@supabase/supabase-js": "2.108.1",
    "@types/react": "^19.3.3",
    "base64-js": "1.5.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "expo": "58.0.26",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.21",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-linking": "~58.0.17",
    "expo-network": "~58.0.5",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-task-manager": "~58.0.14",
    "fast-text-encoding": "1.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-url-polyfill": "^3.0.0",
    "tailwind-merge": "3.6.0",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
